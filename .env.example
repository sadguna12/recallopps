# =======================================================
# AI Incident Response Agent - Environment Configuration
# =======================================================

# Application
PROJECT_NAME="AI Incident Response Agent"
ENVIRONMENT="development"
DEBUG=true

# Storage
DATABASE_URL="sqlite:///./incident_agent.db"
CHROMA_PERSIST_DIR="./chroma_db"

# AI Provider Configuration
# Options: "demo" (Zero-API Key Offline Mode), "openai", "gemini", "anthropic"
LLM_PROVIDER="demo"
LLM_MODEL="gpt-4o"
LLM_API_KEY=""

# Embedding Provider Configuration
# Options: "chromadb_default", "openai", "local_cosine"
EMBEDDING_PROVIDER="chromadb_default"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_API_KEY=""

# RAG Configuration
TOP_K_RETRIEVAL=4
DEMO_MODE=true
